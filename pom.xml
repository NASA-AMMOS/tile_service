<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">

    <modelVersion>4.0.0</modelVersion>

    <name>JPL - AMMOS - MIPL - Mars - WebMarsviewer Tile Service</name>
    <description>EDR/RDR image tiling server for Web Marsviewer</description>

    <groupId>gov.nasa.jpl.ammos.ids.mipl.mars.tile_service</groupId>
    <artifactId>image_tiler</artifactId>
    <version>${revision}</version>
    <packaging>${packaging.type}</packaging>

    <properties>

        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>

        <semver>6.5.8</semver>
        <buildnum/>
        <sha1/>
        <changelist>-SNAPSHOT</changelist>
        <revision>${semver}${buildnum}${sha1}${changelist}</revision>

        <packaging.type>jar</packaging.type>
        <webXml.location>webapp/WEB-INF/docker-web.xml</webXml.location>

        <version.plugin.compiler>3.8.1</version.plugin.compiler>
        <version.plugin.resources>3.2.0</version.plugin.resources>
        <version.plugin.shade>3.2.4</version.plugin.shade>
        <version.plugin.war>3.5.1</version.plugin.war>

        <version.log4j2>2.24.3</version.log4j2>
        <version.slf4j>2.0.13</version.slf4j>
        <version.commons-logging>1.3.2</version.commons-logging>
        <version.commons-exec>1.3</version.commons-exec>
        <version.commons-io>2.11.0</version.commons-io>
        <version.commons-validator>1.7</version.commons-validator>
        <version.commons-lang3>3.12.0</version.commons-lang3>
        <version.commons-cli>1.4</version.commons-cli>
        <version.javax.json>1.1.4</version.javax.json>
        <version.jai_core>1.1.3</version.jai_core>
        <version.jai_codec>1.1.3</version.jai_codec>
        <version.jai_imageio>1.1</version.jai_imageio>
        <version.thumbnailator>0.4.14</version.thumbnailator>
        <version.pyramidio>1.1.0</version.pyramidio>
        <version.aws-lambda-java-core>1.4.0</version.aws-lambda-java-core>
        <version.aws-lambda-java-events>3.16.1</version.aws-lambda-java-events>
        <version.aws-java-v2-bom>2.42.19</version.aws-java-v2-bom>
        <version.mars>3.8.2-SNAPSHOT</version.mars>
        <version.vicario>2.7.0-SNAPSHOT</version.vicario>
        <version.tomcat-catalina>9.0.50</version.tomcat-catalina>

    </properties>

    <repositories>
      <!-- JAI artifacts (jai_core, jai_codec, jai_imageio) are hosted by OSGeo -->
      <repository>
        <id>osgeo</id>
        <name>OSGeo Release Repository</name>
        <url>https://repo.osgeo.org/repository/release/</url>
        <snapshots>
          <enabled>true</enabled>
        </snapshots>
      </repository>
    </repositories>

    <build>
        <finalName>image_tiler</finalName>

        <resources>
            <resource>
                <directory>${project.basedir}/webapp</directory>
                <excludes>
                    <exclude>**/*.java</exclude>
                </excludes>
            </resource>
        </resources>

        <plugins>

            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>${version.plugin.compiler}</version>
                <configuration>
                    <source>21</source>
                    <target>21</target>
                </configuration>
            </plugin>

            <!-- remove __MACOSX entries in objectAccess jar for WAR packaging -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-dependency-plugin</artifactId>
                <executions>
                    <execution>
                        <id>copy-dependencies</id>
                        <phase>prepare-package</phase>
                        <goals>
                            <goal>copy-dependencies</goal>
                        </goals>
                        <configuration>
                            <outputDirectory>${project.build.directory}/original-deps</outputDirectory>
                            <includeArtifactIds>objectAccess</includeArtifactIds>
                        </configuration>
                    </execution>
                </executions>
            </plugin>

            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>exec-maven-plugin</artifactId>
                <version>3.1.0</version>
                <executions>
                    <execution>
                        <id>clean-objectaccess-jar</id>
                        <phase>prepare-package</phase>
                        <goals>
                            <goal>exec</goal>
                        </goals>
                        <configuration>
                            <executable>bash</executable>
                            <arguments>
                                <argument>-c</argument>
                                <argument>
                                    mkdir -p ${project.build.directory}/cleaned-jars &amp;&amp;
                                    cp ${project.build.directory}/original-deps/objectAccess-*.jar ${project.build.directory}/cleaned-jars/ &amp;&amp;
                                    cd ${project.build.directory}/cleaned-jars &amp;&amp;
                                    zip -d objectAccess-*.jar '__MACOSX/*' '**/._*' 2&gt;/dev/null || true
                                </argument>
                            </arguments>
                        </configuration>
                    </execution>
                </executions>
            </plugin>

            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-resources-plugin</artifactId>
                <version>${version.plugin.resources}</version>
                <executions>
                    <execution>
                        <id>copy-version</id>
                        <phase>prepare-package</phase>
                        <goals>
                            <goal>copy-resources</goal>
                        </goals>
                        <!-- orchestrate version file into a specific packaging location -->
                        <configuration>
                            <overwrite>true</overwrite>
                            <outputDirectory>${project.build.outputDirectory}/resources</outputDirectory>
                            <resources>
                                <resource>
                                    <directory>${project.basedir}/webapp</directory>
                                    <includes>
                                        <include>version</include>
                                    </includes>
                                    <filtering>true</filtering>
                                </resource>
                            </resources>
                        </configuration>
                    </execution>
                </executions>
            </plugin>

            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-shade-plugin</artifactId>
                <version>${version.plugin.shade}</version>
                <configuration>
                    <createDependencyReducedPom>false</createDependencyReducedPom>
                </configuration>
                <executions>
                    <execution>
                        <phase>package</phase>
                        <goals>
                            <goal>shade</goal>
                        </goals>
                        <configuration>
                            <transformers>
                                <transformer implementation="org.apache.maven.plugins.shade.resource.ServicesResourceTransformer"/>
                                <transformer implementation="org.apache.maven.plugins.shade.resource.ManifestResourceTransformer">
                                  <manifestEntries>
                                    <Main-Class>jpl.mipl.mars.tile_service.TileCLI</Main-Class>
                                    <Add-Exports>java.desktop/com.sun.imageio.plugins.common</Add-Exports>

                                    <!-- avoid
                                         java.util.ServiceConfigurationError: javax.imageio.spi.ImageWriterSpi:
                                         Provider com.sun.media.imageioimpl.plugins.jpeg.CLibJPEGImageWriterSpi
                                         could not be instantiated
                                         Caused by: java.lang.IllegalArgumentException: vendorName == null
                                    -->
                                    <Specification-Title>Java Advanced Imaging Image I/O Tools</Specification-Title>
                                    <Specification-Version>1.1</Specification-Version>
                                    <Specification-Vendor>Sun Microsystems, Inc.</Specification-Vendor>
                                    <Implementation-Title>com.sun.media.imageio</Implementation-Title>
                                    <Implementation-Version>1.1</Implementation-Version>
                                    <Implementation-Vendor>Sun Microsystems, Inc.</Implementation-Vendor>

                                  </manifestEntries>
                                </transformer>
                            </transformers>
                            <artifactSet>
                                <excludes>
                                    <!-- don't use older version of libs included with pyramidio -->
                                    <exclude>org.apache.commons:commons-io</exclude> 
                                    <exclude>com.github.jai-imageio:jai-imageio-core</exclude>
                                    <!-- don't use older version of libs included with vicario -->
                                    <exclude>xerces:xercesImpl</exclude> 
                                    <exclude>xml-apis:xml-apis</exclude>
                                    <exclude>regexp:regexp</exclude>
                                </excludes>
                            </artifactSet>
                            <filters>
                                <filter>
                                    <artifact>*:*</artifact>
                                    <excludes>
                                        <!-- exclude macOS resource fork metadata entries -->
                                        <exclude>__MACOSX/**</exclude>
                                        <exclude>**/._*</exclude>
                                    </excludes>
                                </filter>
                                <filter>
                                    <artifact>gov.nist.isg:pyramidio</artifact>
                                    <excludes>
                                        <!-- https://github.com/usnistgov/pyramidio/issues/12 -->
                                        <exclude>gov/nist/isg/pyramidio/tools/ImageResizingHelper.class</exclude>
                                        <!-- https://github.com/usnistgov/pyramidio/issues/15 -->
                                        <exclude>gov/nist/isg/pyramidio/TileBuilder.class</exclude>
                                        <exclude>gov/nist/isg/pyramidio/TileBuilder$1.class</exclude>
                                        <exclude>gov/nist/isg/pyramidio/TileBuilder$Task.class</exclude>
                                    </excludes>
                                </filter>
                                <filter>
                                    <artifact>gov.nasa.jpl.ammos.ids:mars</artifact>
                                    <excludes>
                                        <!-- disable mars.jar override of JDK xml libs with xerces -->
                                        <exclude>META-INF/services/javax.xml.parsers.DocumentBuilderFactory</exclude>
                                    </excludes>
                                </filter>
                            </filters>
                        </configuration>
                    </execution>
                </executions>
            </plugin>

            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-war-plugin</artifactId>
                <version>${version.plugin.war}</version>
                <configuration>
                    <archive>
                      <manifestEntries>
                        <Add-Exports>java.desktop/com.sun.imageio.plugins.common</Add-Exports>
                      </manifestEntries>
                    </archive>
                    <warSourceDirectory>webapp</warSourceDirectory>
                    <webXml>${webXml.location}</webXml>
                    <!-- don't use older version of libs included with pyramidio -->
                    <!-- don't use older version of libs included with vicario -->
                    <packagingExcludes>
                        WEB-INF/lib/commons-io-1.*.jar,
                        WEB-INF/lib/regexp-1.*.jar,
                        WEB-INF/lib/xercesImpl-2.4.*.jar,
                        WEB-INF/lib/xml-apis-1.3.*.jar,
                        WEB-INF/lib/objectAccess-*.jar  <!-- remove __MACOSX entries in objectAccess jar -->
                    </packagingExcludes>
                    <webResources>
                        <resource>
                            <directory>${project.build.directory}/cleaned-jars</directory>
                            <targetPath>WEB-INF/lib</targetPath>
                            <includes>
                                <include>objectAccess-*.jar</include>
                            </includes>
                        </resource>
                    </webResources>
                </configuration>
            </plugin>

        </plugins>

    </build>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>software.amazon.awssdk</groupId>
                <artifactId>bom</artifactId>
                <version>${version.aws-java-v2-bom}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <dependency>
              <groupId>org.apache.logging.log4j</groupId>
              <artifactId>log4j-bom</artifactId>
              <version>${version.log4j2}</version>
              <type>pom</type>
              <scope>import</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <dependencies>
        <dependency>
            <groupId>gov.nasa.jpl.ammos.ids</groupId>
            <artifactId>mars</artifactId>
            <version>${version.mars}</version>
            <exclusions>
              <!-- don't include old AWS 1.x java API -->
              <exclusion>
                <groupId>com.amazonaws</groupId>
                <artifactId>aws-java-sdk-s3</artifactId>
              </exclusion>
              <exclusion>
                <groupId>*</groupId>
                <artifactId>jai_codec</artifactId>
              </exclusion>
              <exclusion>
                <groupId>*</groupId>
                <artifactId>mlibwrapper_jai</artifactId>
              </exclusion>
              <exclusion>
                <groupId>*</groupId>
                <artifactId>jogl</artifactId>
              </exclusion>
              <exclusion>
                <groupId>*</groupId>
                <artifactId>jME3-core</artifactId>
              </exclusion>
              <exclusion>
                <groupId>*</groupId>
                <artifactId>jME3-desktop</artifactId>
              </exclusion>
            </exclusions>
        </dependency>
        <dependency>
            <groupId>gov.nasa.jpl.ammos.ids</groupId>
            <artifactId>vicario</artifactId>
            <version>${version.vicario}</version>
            <exclusions>
                <exclusion>
                    <groupId>xerces</groupId>
                    <artifactId>xercesImpl</artifactId>
                </exclusion>
                <exclusion>
                    <groupId>xml-apis</groupId>
                    <artifactId>xml-apis</artifactId>
                </exclusion>
                <exclusion>
                    <groupId>regexp</groupId>
                    <artifactId>regexp</artifactId>
                </exclusion>
            </exclusions>
        </dependency>
        <dependency>
          <groupId>org.apache.tomcat</groupId>
          <artifactId>tomcat-catalina</artifactId>
          <version>${version.tomcat-catalina}</version>
        </dependency>
        <dependency>
            <groupId>org.apache.commons</groupId>
            <artifactId>commons-exec</artifactId>
            <version>${version.commons-exec}</version>
        </dependency>
        <dependency>
            <groupId>commons-io</groupId>
            <artifactId>commons-io</artifactId>
            <version>${version.commons-io}</version>
        </dependency>
        <dependency>
            <groupId>commons-validator</groupId>
            <artifactId>commons-validator</artifactId>
            <version>${version.commons-validator}</version>
        </dependency>
        <dependency>
          <groupId>org.apache.commons</groupId>
          <artifactId>commons-lang3</artifactId>
          <version>${version.commons-lang3}</version>
        </dependency>
        <dependency>
            <groupId>commons-cli</groupId>
            <artifactId>commons-cli</artifactId>
            <version>${version.commons-cli}</version>
        </dependency>
        <dependency>
          <groupId>org.slf4j</groupId>
          <artifactId>slf4j-api</artifactId>
          <version>${version.slf4j}</version>
        </dependency>
        <dependency>
          <groupId>org.slf4j</groupId>
          <artifactId>slf4j-simple</artifactId>
          <version>${version.slf4j}</version>
        </dependency>
        <dependency>
          <groupId>commons-logging</groupId>
          <artifactId>commons-logging</artifactId>
          <version>${version.commons-logging}</version>
        </dependency>
        <dependency>
          <groupId>org.glassfish</groupId>
          <artifactId>javax.json</artifactId>
          <version>${version.javax.json}</version>
        </dependency>
        <dependency>
            <groupId>javax.media</groupId>
            <artifactId>jai_core</artifactId>
            <version>${version.jai_core}</version>
        </dependency>
        <dependency>
            <groupId>javax.media</groupId>
            <artifactId>jai_codec</artifactId>
            <version>${version.jai_codec}</version>
        </dependency>
        <dependency>
            <groupId>javax.media</groupId>
            <artifactId>jai_imageio</artifactId>
            <version>${version.jai_imageio}</version>
        </dependency>
        <dependency>
            <groupId>net.coobird</groupId>
            <artifactId>thumbnailator</artifactId>
            <version>${version.thumbnailator}</version>
        </dependency>
        <dependency>
          <groupId>gov.nist.isg</groupId>
          <artifactId>pyramidio</artifactId>
          <version>${version.pyramidio}</version>
          <exclusions>
                <exclusion>
                    <groupId>org.apache.commons</groupId>
                    <artifactId>commons-io</artifactId>
                </exclusion>
                <exclusion>
                    <groupId>com.github.jai-imageio</groupId>
                    <artifactId>jai-imageio-core</artifactId>
                </exclusion>
          </exclusions>
        </dependency>

        <!-- AWS SDK for Java 2.x -->
        <!-- versions are determined by the BOM imported above -->
        <dependency>
            <groupId>software.amazon.awssdk</groupId>
            <artifactId>s3</artifactId>
        </dependency>
        <dependency>
            <groupId>software.amazon.awssdk</groupId>
            <artifactId>s3-event-notifications</artifactId>
        </dependency>
        <dependency>
            <groupId>software.amazon.awssdk</groupId>
            <artifactId>sqs</artifactId>
        </dependency>
        <dependency>
            <groupId>software.amazon.awssdk</groupId>
            <artifactId>utils</artifactId>
        </dependency>
        <dependency>
            <groupId>software.amazon.awssdk</groupId>
            <artifactId>sdk-core</artifactId>
        </dependency>
        <dependency>
          <groupId>software.amazon.awssdk</groupId>
          <artifactId>apache-client</artifactId>
        </dependency>

        <!-- AWS Lambda java is still on 1.x -->
        <!-- https://github.com/aws/aws-lambda-java-libs -->
        <dependency>
            <groupId>com.amazonaws</groupId>
            <artifactId>aws-lambda-java-core</artifactId>
            <version>${version.aws-lambda-java-core}</version>
        </dependency>
        <dependency>
            <groupId>com.amazonaws</groupId>
            <artifactId>aws-lambda-java-events</artifactId>
            <version>${version.aws-lambda-java-events}</version>
        </dependency>
    </dependencies>

    <profiles>
        <profile>
            <activation>
                <activeByDefault>true</activeByDefault>
            </activation>
            <id>jar</id>
            <properties>
                <packaging.type>jar</packaging.type>
            </properties>
        </profile>
        <profile>
            <id>war-localhost-fscache</id>
            <properties>
                <packaging.type>war</packaging.type>
                <webXml.location>webapp/WEB-INF/localhost-fscache-web.xml</webXml.location>
            </properties>
        </profile>
        <profile>
            <id>war-docker</id>
            <properties>
                <packaging.type>war</packaging.type>
                <webXml.location>webapp/WEB-INF/docker-web.xml</webXml.location>
            </properties>
        </profile>
    </profiles>

</project>
