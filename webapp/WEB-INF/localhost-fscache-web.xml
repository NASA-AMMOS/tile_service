    <init-param>
      <param-name>ignore_subdirs</param-name>
      <param-value>ids-pipeline,browse,orbital</param-value>
    </init-param>
    <init-param>
      <param-name>enable_s3</param-name>
      <param-value>false</param-value>
    </init-param>
    <init-param>
      <param-name>enable_http</param-name>
      <param-value>true</param-value>
    </init-param>
    <init-param>
      <param-name>rdr_url_whitelist_patterns</param-name>
