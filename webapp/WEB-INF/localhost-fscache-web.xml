    <init-param>
      <param-name>enable_sqs</param-name>
      <param-value>false</param-value>
    </init-param>
    <init-param>
      <param-name>data_url</param-name>
      <param-value></param-value>
    </init-param>
    <init-param>
      <param-name>tile_url</param-name>
      <param-value></param-value>
    </init-param>
    <init-param>
      <param-name>dzi_protocol_override</param-name>
      <param-value></param-value>
    </init-param>
    <init-param>
      <param-name>dzi_host_override</param-name>
      <param-value></param-value>
    </init-param>
    <init-param>
      <param-name>dzi_port_override</param-name>
      <param-value></param-value>
    </init-param>
    <init-param>
      <param-name>dzi_path_override</param-name>
