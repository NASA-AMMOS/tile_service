<?xml version="1.0" encoding="ISO-8859-1"?>

<web-app>
  <servlet>
    <servlet-name>TileService</servlet-name>
    <servlet-class>jpl.mipl.mars.tile_service.TileService</servlet-class>
    <init-param>
      <param-name>debug_tiler</param-name>
      <param-value>false</param-value>
    </init-param>
    <init-param>
      <param-name>tuning_hacks</param-name>
      <param-value>false</param-value>
    </init-param>
    <init-param>
      <param-name>ignore_subdirs</param-name>
      <param-value>ids-pipeline,browse,orbital</param-value>
    </init-param>
    <init-param>
      <param-name>enable_s3</param-name>
      <param-value>true</param-value>
    </init-param>
    <init-param>
      <param-name>enable_http</param-name>
      <param-value>true</param-value>
    </init-param>
    <init-param>
      <param-name>rdr_url_whitelist_patterns</param-name>
      <param-value></param-value>
    </init-param>
    <init-param>
      <param-name>enable_sqs</param-name>
      <param-value>true</param-value>
    </init-param>
    <init-param>
      <param-name>aws_profile</param-name>
      <param-value>credss-default</param-value>
    </init-param>
    <init-param>
      <param-name>aws_region</param-name>
      <param-value></param-value>
    </init-param>
    <init-param>
      <param-name>cache_s3_credentials</param-name>
      <param-value>64</param-value>
    </init-param>
    <init-param>
      <param-name>max_s3_credentials_age</param-name>
      <param-value>300</param-value>
    </init-param>
    <init-param>
      <param-name>tile_service_queue_name</param-name>
      <param-value>m20-gd-ids-tile-service-test-input-queue</param-value>
    </init-param>
    <init-param>
      <param-name>fail_queue_name</param-name>
      <param-value>m20-gd-ids-tile-service-test-input-queue-dlq</param-value>
    </init-param>
    <init-param>
      <param-name>data_url</param-name>
      <param-value>https://data.gd.m20.jpl.nasa.gov</param-value>
    </init-param>
    <init-param>
      <param-name>tile_url</param-name>
      <param-value></param-value>
    </init-param>
    <init-param>
      <param-name>dzi_protocol_override</param-name>
      <param-value></param-value>
    </init-param>
    <init-param>
      <param-name>dzi_host_override</param-name>
      <param-value></param-value>
    </init-param>
    <init-param>
      <param-name>dzi_port_override</param-name>
      <param-value></param-value>
    </init-param>
    <init-param>
      <param-name>dzi_path_override</param-name>
      <param-value></param-value>
    </init-param>
    <init-param>
      <param-name>dzi_suffix_override</param-name>
      <param-value></param-value>
    </init-param>
    <init-param>
      <param-name>redirect_cached</param-name>
      <param-value>true</param-value>
    </init-param>
    <init-param>
      <param-name>fs_input_dir</param-name>
      <param-value></param-value>
    </init-param>
    <init-param>
      <param-name>cache_type</param-name>
      <param-value>s3</param-value>
    </init-param>
    <init-param>
      <param-name>s3_cache_bucket_name</param-name>
      <param-value>m20-gd-ids</param-value>
    </init-param>
    <init-param>
      <param-name>s3_cache_loc</param-name>
      <param-value>m20-gd-ids-tile-service-test/cache</param-value>
    </init-param>
    <init-param>
      <param-name>use_aws_header</param-name>
      <param-value>prefer</param-value>
    </init-param>
    <init-param>
      <param-name>cache_s3_credentials</param-name>
      <param-value>auto</param-value>
    </init-param>
    <init-param>
      <param-name>max_s3_credentials_age</param-name>
      <param-value>auto</param-value>
    </init-param>
    <init-param>
      <param-name>verify_client_credentials</param-name>
      <param-value>true</param-value>
    </init-param>
    <init-param>
      <param-name>check_etag_value</param-name>
      <param-value>true</param-value>
    </init-param>
    <init-param>
      <param-name>lambda_wait_time</param-name>
      <param-value>60s</param-value>
    </init-param>
    <init-param>
      <param-name>lambda_max_rdr_bytes</param-name>
      <param-value>2.5g</param-value>
    </init-param>
    <init-param>
      <param-name>lambda_max_image_bytes</param-name>
      <param-value>2g</param-value>
    </init-param>
    <init-param>
      <param-name>max_concurrent_tasks</param-name>
      <param-value>auto</param-value>
    </init-param>
    <init-param>
      <param-name>lru_mem_cache_pages</param-name>
      <param-value>100%</param-value>
    </init-param>
    <init-param>
      <param-name>lru_disk_cache_pages</param-name>
      <param-value>100%</param-value>
    </init-param>
    <init-param>
      <param-name>lru_disk_cache_dir</param-name>
      <param-value>tmp</param-value>
    </init-param>
    <init-param>
      <param-name>stretch_type</param-name>
      <param-value>auto</param-value>
    </init-param>
    <init-param>
      <param-name>stretch_low</param-name>
      <param-value>auto</param-value>
    </init-param>
    <init-param>
      <param-name>stretch_high</param-name>
      <param-value>auto</param-value>
    </init-param>
  </servlet>
  <servlet-mapping>
    <servlet-name>TileService</servlet-name>
    <url-pattern>/*</url-pattern>
  </servlet-mapping>
</web-app>
